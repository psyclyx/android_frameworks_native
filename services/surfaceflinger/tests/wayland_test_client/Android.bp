package {
    default_applicable_licenses: ["frameworks_native_license"],
}

cc_binary {
    name: "wayland_egl_test",
    srcs: ["wayland_egl_test.cpp"],

    static_libs: [
        "libwayland_client_static",
        "libwayland_extension_client_protocols",
        "libffi",
    ],

    shared_libs: [
        "libEGL",
        "libGLESv2",
        "libgui",
        "libui",
        "libutils",
        "libnativewindow",
        "liblog",
    ],

    header_libs: [
        "libui_headers",
        "libnativewindow_headers",
        "libdrm_headers",
    ],

    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-Wno-unused-parameter",
    ],
}

cc_binary {
    name: "wayland_shm_test",
    srcs: ["wayland_shm_test.cpp"],

    static_libs: [
        "libwayland_client_static",
        "libwayland_extension_client_protocols",
        "libffi",
    ],

    shared_libs: [
        "liblog",
    ],

    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-Wno-unused-parameter",
    ],
}
